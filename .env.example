# Copia este archivo a .env si quieres cargar variables desde el proyecto.
# El asistente usa Codex CLI local por defecto. No requiere claves API en el proyecto.

LLM_BACKEND=codex_cli
CODEX_COMMAND=codex
CODEX_TIMEOUT_SECONDS=80
CODEX_MODEL=
CODEX_REASONING_LEVEL=low
CODEX_SANDBOX=read-only
CODEX_BYPASS_APPROVALS_AND_SANDBOX=false

ASSISTANT_LANGUAGE=es
WHISPER_MODEL=small

TTS_ENGINE=kokoro
VOICE_PROFILE=deep_male_latam_ai
KOKORO_LANG=e
KOKORO_VOICE=em_alex
KOKORO_SPEED=0.82
KOKORO_PYTHON=
VOICE_STYLE=deep_male_latam_ai
ESPEAK_VOICE=es-la+m3

# Piper TTS. Si PIPER_MODEL queda vacio, se autodetectan modelos locales cuando existan.
# Voz fluida recomendada:
# PIPER_MODEL=/home/julian/.local/share/piper/voices/es_MX/claude/high/es_MX-claude-high.onnx
# PIPER_VOICE_CONFIG=/home/julian/.local/share/piper/voices/es_MX/claude/high/es_MX-claude-high.onnx.json
# Voz grave alternativa:
# PIPER_MODEL=/home/julian/.local/share/piper/voices/es_ES/davefx/medium/es_ES-davefx-medium.onnx
# PIPER_VOICE_CONFIG=/home/julian/.local/share/piper/voices/es_ES/davefx/medium/es_ES-davefx-medium.onnx.json
PIPER_MODEL=
PIPER_VOICE_CONFIG=
PIPER_CONFIG=
PIPER_LENGTH_SCALE=1.25
PIPER_SENTENCE_SILENCE=0.45
TTS_SPEED=0.82
TTS_VOLUME=1.0
VOICE_EFFECTS=true
VOICE_PITCH=-420
VOICE_TEMPO=0.86
VOICE_BASS=6
VOICE_COMPRESS=true
VOICE_REVERB=none

REQUIRE_CONFIRMATION_FOR_SUDO=true
DISABLE_SAFETY_CONFIRMATIONS=false
SCREENSHOT_PATH=/tmp/voice-assistant-screen.png

# Daemon / Handy
ASSISTANT_LOG_DIR=/home/julian/.local/share/voice-codex-assistant/logs
TRIGGER_SOCKET_PATH=/run/user/1000/voice-codex-assistant.sock
DAEMON_POLL_SECONDS=0.5
HANDY_AUTOSTART=true
HANDY_PROCESS_HISTORY=true
HANDY_POLL_SECONDS=0.75
HANDY_APPIMAGE_PATH=/home/julian/Downloads/Handy_0.8.3_amd64.AppImage
HANDY_HISTORY_DB=/home/julian/.local/share/com.pais.handy/history.db

# Opcional: comando personalizado para disparar Handy desde python main.py --trigger.
# Lo mas estable en KDE/Wayland es asignar Alt+Z directamente en Handy.
HANDY_TRIGGER_COMMAND=

# Fallback opcional. No es el flujo principal.
DIRECT_STT_FALLBACK_ENABLED=false
